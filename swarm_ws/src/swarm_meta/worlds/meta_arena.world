<?xml version="1.0"?>
<sdf version="1.6">
  <world name="meta_arena">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so"/>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12 12</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12 12</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.62 0.62 0.62 1</ambient>
            <diffuse>0.62 0.62 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="target_goal">
      <static>true</static>
      <pose>4.0 0.0 0.03 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.20</radius>
              <length>0.06</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.0 0.75 0.15 1</ambient>
            <diffuse>0.0 0.75 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.2 0.12 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.2 0.12 0.5</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.2 0.12 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.2 0.12 0.5</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>5 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 10.2 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 10.2 0.5</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 10.2 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 10.2 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="obstacle_low_1">
      <static>true</static>
      <pose>-1.0 -1.6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry></visual>
      </link>
    </model>
    <model name="obstacle_low_2">
      <static>true</static>
      <pose>-0.5 1.4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry></visual>
      </link>
    </model>
    <model name="obstacle_mid_1">
      <static>true</static>
      <pose>1.0 -0.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 0.45 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.45 0.5</size></box></geometry></visual>
      </link>
    </model>
    <model name="obstacle_mid_2">
      <static>true</static>
      <pose>1.4 1.2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 0.45 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.45 0.5</size></box></geometry></visual>
      </link>
    </model>
    <model name="obstacle_high_1">
      <static>true</static>
      <pose>2.4 -1.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.5</length></cylinder></geometry></visual>
      </link>
    </model>
    <model name="obstacle_high_2">
      <static>true</static>
      <pose>2.7 -0.2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.5</length></cylinder></geometry></visual>
      </link>
    </model>
    <model name="obstacle_high_3">
      <static>true</static>
      <pose>2.4 1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.5</length></cylinder></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
